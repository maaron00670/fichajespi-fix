 #!/bin/bash
 set -e

 echo "#####################__Levantando contenedores__"
 export IP=$(hostname -I | awk '{print $1}')

 if [ -z "$IP" ]; then
   echo "No se pudo obtener la IP local de la Raspberry Pi"
   exit 1
 fi

 cd "$(dirname "$0")"
 if docker compose version >/dev/null 2>&1; then
   docker compose up -d
 else
   docker-compose up -d
 fi
